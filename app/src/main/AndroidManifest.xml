<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <permission android:name="btm.m.os4.systemuihook.permission.LAUNCH_REAR_MINI_PLAYER"
        android:protectionLevel="signature" />
    <uses-permission android:name="btm.m.os4.systemuihook.permission.LAUNCH_REAR_MINI_PLAYER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />
    <application
        android:name=".HookApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_hyperchanger"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:roundIcon="@drawable/ic_hyperchanger"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperSystemUIHook">
        <service android:name=".ModuleLogCleanupService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.modulelogs" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/module_log_paths" />
        </provider>
        <provider android:name=".DevicePresetFileProvider"
            android:authorities="${applicationId}.devicepresets" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/device_preset_paths" />
        </provider>
        <meta-data
            android:name="xposeddescription"
            android:resource="@string/xposed_description" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".LauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/ic_hyperchanger"
            android:roundIcon="@drawable/ic_hyperchanger"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver
            android:name=".MediaNotificationActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".NotificationSimulatorReceiver"
            android:exported="false" />
        <receiver
            android:name=".IslandSimulationReceiver"
            android:exported="false" />
        <service
            android:name=".RasterWallpaperService"
            android:exported="true"
            android:label="@string/raster_wallpaper_description"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/raster_wallpaper" />
        </service>
        <provider
            android:name=".SettingsAppearanceProvider"
            android:authorities="btm.m.os4.systemuihook.settingsappearance"
            android:exported="true"
            android:grantUriPermissions="true" />
        <provider
            android:name=".StatusBarIconProvider"
            android:authorities="btm.m.os4.systemuihook.statusbaricons"
            android:exported="true" />
        <provider
            android:name=".DockMaterialProvider"
            android:authorities="btm.m.os4.systemuihook.dockmaterial"
            android:exported="true" />
        <provider
            android:name=".RearScreenshotShellProvider"
            android:authorities="btm.m.os4.systemuihook.rearscreenshot.shells"
            android:exported="true" />
    </application>
</manifest>
